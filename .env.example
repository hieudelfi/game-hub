# Sao chép thành .env.local, KHÔNG commit .env.local

# Supabase — điền sau khi tạo project ở supabase.com (Task P0-4)
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...

# Web Push VAPID — sinh bằng: npx web-push generate-vapid-keys (dùng ở Phase 4)
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cloudflare R2 (không cần ở MVP; điền ở Phase 4)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ROMS=gamehub-roms
